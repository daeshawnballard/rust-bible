{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rust-bible-narration",
  "main": "./worker.mjs",
  "compatibility_date": "2026-05-22",
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "site-creator-r2"
    }
  ]
}
